{% if json_output %}
{% set aaa = json_output %}
{% set auth = {} %}
{% set authz = {} %}
{% set acct = {} %}

{% if "openconfig-system:aaa" in aaa %}
{% set aaa = aaa["openconfig-system:aaa"] %}
{% elif "openconfig-aaa:aaa" in aaa %}
{% set aaa = aaa["openconfig-aaa:aaa"] %}
{% endif %}

{% if "authentication" in aaa %}
{% if "config" in aaa["authentication"] %}
{% set auth = aaa["authentication"]["config"] %}
{% elif "state" in aaa["authentication"] %}
{% set auth = aaa["authentication"]["state"] %}
{% endif %}
{% endif %}

{% if "authorization" in aaa %}
{% if "config" in aaa["authorization"] %}
{% set authz = aaa["authorization"]["config"] %}
{% elif "state" in aaa["authorization"] %}
{% set authz = aaa["authorization"]["state"] %}
{% endif %}
{% endif %}

{% if "accounting" in aaa %}
{% if "config" in aaa["accounting"] %}
{% set acct = aaa["accounting"]["config"] %}
{% elif "state" in aaa["accounting"] %}
{% set acct = aaa["accounting"]["state"] %}
{% endif %}
{% endif %}

{% if "authentication-method" in auth %}
AAA authentication login {{ auth["authentication-method"]|join(",") }}
{% else %}
AAA authentication login local (default)
{% endif %}
{% if "openconfig-aaa-ext:failthrough" in auth %}
AAA authentication failthrough {{ auth["openconfig-aaa-ext:failthrough"] }}
{% elif "failthrough" in auth %}
AAA authentication failthrough {{ auth["failthrough"] }}
{% else %}
AAA authentication failthrough False (default)
{% endif %}
{% if "openconfig-aaa-ext:fallback" in auth %}
AAA authentication fallback {{ auth["openconfig-aaa-ext:fallback"] }}
{% elif "fallback" in auth %}
AAA authentication fallback {{ auth["fallback"] }}
{% endif %}
{% if "openconfig-aaa-ext:debug" in auth %}
AAA authentication debug {{ auth["openconfig-aaa-ext:debug"] }}
{% elif "debug" in auth %}
AAA authentication debug {{ auth["debug"] }}
{% endif %}
{% if "authorization-method" in authz %}
AAA authorization login {{ authz["authorization-method"]|join(",") }}
{% else %}
AAA authorization login local (default)
{% endif %}
{% if "accounting-method" in acct %}
AAA accounting login {{ acct["accounting-method"]|join(",") }}
{% else %}
AAA accounting login disable (default)
{% endif %}
{% endif %}
